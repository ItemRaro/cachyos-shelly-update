# After a Python upgrade: rebuilds the tray's virtualenv and recompiles the
# package's bytecode for the new Python.
# A virtualenv is tied to the Python minor version (3.14 -> 3.15 breaks it);
# rebuild-venv only rebuilds when the version or requirements.txt changed.
[Trigger]
Operation = Upgrade
Type = Package
Target = python

[Action]
Description = Updating cachyos-shelly-update for the new Python...
When = PostTransaction
Exec = /opt/cachyos-shelly-update/install.sh rebuild-venv
