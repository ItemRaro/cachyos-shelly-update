#!/usr/bin/env bash
#
# cachyos-shelly-update — atualizador no estilo do arch-update/cachy-update,
# usando o Shelly como backend (repositórios, AUR, Flatpak e AppImage).
#
# Uso:
#   cachyos-shelly-update             lista as atualizações, pergunta e aplica
#   cachyos-shelly-update -c          verifica em segundo plano (usado pelo timer):
#                             grava o estado, atualiza o ícone da bandeja e notifica
#   cachyos-shelly-update -l          só lista o que há para atualizar (sem atualizar)
#   cachyos-shelly-update -y          atualiza sem perguntar (usa o -n do Shelly)
#   cachyos-shelly-update --tray      inicia o ícone da bandeja
#   cachyos-shelly-update --no-aur --no-flatpak --no-appimage --no-repo --no-devel
#                             pula origens específicas
#   cachyos-shelly-update --appman    também roda "appman -u" ao atualizar
#   cachyos-shelly-update -V          versão
#   cachyos-shelly-update -h          ajuda
#
# Configuração opcional: ~/.config/cachyos-shelly-update/cachyos-shelly-update.conf
#   (mesmas opções acima, uma por linha, ex.: --appman)
#
# Atualizar/remover: /opt/cachyos-shelly-update/install.sh {update|uninstall}

set -uo pipefail

NAME=cachyos-shelly-update
# Instalado em /opt/cachyos-shelly-update/bin (com link em /usr/local/bin): acha a própria pasta
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PREFIX="$(cd "$(dirname "$SELF")/.." && pwd)"
LIBDIR="${CACHYOS_SHELLY_UPDATE_LIBDIR:-$PREFIX/lib}"
STATEDIR="${XDG_STATE_HOME:-$HOME/.local/state}/$NAME"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/$NAME/$NAME.conf"
mkdir -p "$STATEDIR"

# ---------- cores ----------
if [[ -t 1 ]]; then
    B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; C=$'\e[36m'; N=$'\e[0m'
else
    B=''; G=''; Y=''; R=''; C=''; N=''
fi
info()  { printf '%s==>%s %s%s%s\n' "$G" "$N" "$B" "$*" "$N"; }
warn()  { printf '%s==> AVISO:%s %s\n' "$Y" "$N" "$*"; }
erro()  { printf '%s==> ERRO:%s %s\n' "$R" "$N" "$*" >&2; }
titulo(){ printf '\n%s:: %s%s\n' "$C$B" "$*" "$N"; }

# ---------- opções ----------
MODO=update            # update | check | list | tray
SEM_CONFIRMAR=0
USAR_APPMAN=0
SEM_DEVEL=0
AGUARDAR=0             # --wait: segura o terminal aberto no final (usado pela bandeja)
declare -A ATIVO=([repo]=1 [aur]=1 [flatpak]=1 [appimage]=1)

ajuda() { sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }

parse_opt() {
    case "$1" in
        -c|--check)    MODO=check ;;
        -l|--list)     MODO=list ;;
        --tray)        MODO=tray ;;
        -y|--yes)      SEM_CONFIRMAR=1 ;;
        --no-repo)     ATIVO[repo]=0 ;;
        --no-aur)      ATIVO[aur]=0 ;;
        --no-flatpak)  ATIVO[flatpak]=0 ;;
        --no-appimage) ATIVO[appimage]=0 ;;
        --no-devel)    SEM_DEVEL=1 ;;
        --appman)      USAR_APPMAN=1 ;;
        --wait)        AGUARDAR=1 ;;
        -V|--version)  echo "$NAME $(cat "$PREFIX/VERSION" 2>/dev/null || echo dev)"; exit 0 ;;
        -h|--help)     ajuda ;;
        *) erro "Opção desconhecida: $1"; exit 1 ;;
    esac
}

# Config primeiro, linha de comando depois
if [[ -f $CONFIG ]]; then
    while read -r linha; do
        linha="${linha%%#*}"; linha="${linha//[[:space:]]/}"
        [[ -n $linha ]] && parse_opt "$linha"
    done < "$CONFIG"
fi
while (($#)); do parse_opt "$1"; shift; done

fim() {
    if ((AGUARDAR)); then
        echo; read -rp "Pressione Enter para fechar..." _
    fi
    exit "$1"
}

# ---------- bandeja ----------
if [[ $MODO == tray ]]; then
    CACHYOS_SHELLY_UPDATE_BIN="$SELF" exec python3 "$LIBDIR/cachyos-shelly-update-tray.py"
fi

command -v shelly >/dev/null 2>&1 || { erro "shelly não encontrado (sudo pacman -S shelly)"; fim 1; }
if ((USAR_APPMAN)) && ! command -v appman >/dev/null 2>&1; then
    warn "appman não instalado; ignorando --appman."; USAR_APPMAN=0
fi

# Impede duas execuções ao mesmo tempo (verificação e atualização)
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/$NAME.lock"
if ! flock -n 9; then
    [[ $MODO == check ]] && exit 0      # o timer simplesmente pula esta rodada
    erro "Outra instância do $NAME já está rodando."; fim 1
fi

# ---------- verificação ----------
# Limpa a saída do Shelly: tira cores, linhas vazias e mensagens de "nada a fazer"
limpar() {
    sed -r 's/\x1B\[[0-9;]*[A-Za-z]//g; s/^[[:space:]]+//' \
    | grep -vE '^$|[Nn]o (updates|packages)|[Uu]p.to.date|[Nn]othing|^(::|==>|Checking|Fetching|Synchroniz)'
}

checar_repo() {
    if command -v checkupdates >/dev/null 2>&1; then
        # Igual ao arch-update: banco temporário, sem root e sem mexer no do sistema
        local tmp; tmp="$(mktemp -d "${TMPDIR:-/tmp}/$NAME-db.XXXXX")"
        CHECKUPDATES_DB="$tmp" checkupdates 2>/dev/null
        rm -rf "$tmp"
    else
        LC_ALL=C shelly list-updates standard 2>/dev/null | limpar
    fi
}
checar_aur() {
    local a=(list-updates aur); ((SEM_DEVEL)) && a+=(--no-devel)
    LC_ALL=C shelly "${a[@]}" 2>/dev/null | limpar
}
checar_flatpak() {
    if command -v flatpak >/dev/null 2>&1; then
        flatpak update --appstream >/dev/null 2>&1
        flatpak remote-ls --updates --columns=name,version 2>/dev/null | tr -s '\t' ' '
    fi
}
checar_appimage() {
    LC_ALL=C shelly list-updates appimage 2>/dev/null | limpar
}

# Grava um arquivo por origem em $STATEDIR/updates_<origem> e tudo junto em updates_all
verificar() {
    local b
    for b in repo aur flatpak appimage; do
        if ((ATIVO[$b])); then
            case $b in
                repo)     checar_repo ;;
                aur)      checar_aur ;;
                flatpak)  checar_flatpak ;;
                appimage) checar_appimage ;;
            esac > "$STATEDIR/updates_$b.tmp"
            mv -f "$STATEDIR/updates_$b.tmp" "$STATEDIR/updates_$b"
        else
            : > "$STATEDIR/updates_$b"
        fi
    done
    cat "$STATEDIR"/updates_{repo,aur,flatpak,appimage} > "$STATEDIR/updates_all.tmp"
    mv -f "$STATEDIR/updates_all.tmp" "$STATEDIR/updates_all"
    date +%s > "$STATEDIR/last_check"
}

# Mesmo ícone e estilo do cachy-update (lê TrayIconStyle/ColorblindMode do arch-update.conf)
icone_atual() {
    local conf="${XDG_CONFIG_HOME:-$HOME/.config}/arch-update/arch-update.conf" estilo cb=""
    estilo=$(grep -hE '^\s*TrayIconStyle\s*=' "$conf" 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '[:space:]')
    [[ $estilo =~ ^(blue|light|dark)$ ]] || estilo=blue
    grep -qE '^\s*ColorblindMode\s*$' "$conf" 2>/dev/null && cb="-cb"
    if [[ -s $STATEDIR/updates_all ]]; then
        echo "cachy-update_updates-available-$estilo$cb"
    else
        echo "cachy-update-$estilo"
    fi
}

notificar_se_mudou() {
    local total txt
    total=$(grep -c . "$STATEDIR/updates_all")
    if ((total > 0)) && ! cmp -s "$STATEDIR/updates_all" "$STATEDIR/notified" 2>/dev/null; then
        if command -v notify-send >/dev/null 2>&1; then
            txt="$total atualização disponível"; ((total > 1)) && txt="$total atualizações disponíveis"
            notify-send -a "CachyOS-Shelly-Update" -i "$(icone_atual)" "CachyOS-Shelly-Update" "$txt" 2>/dev/null
        fi
    fi
    cp -f "$STATEDIR/updates_all" "$STATEDIR/notified"
}

mostrar_lista() {
    local -A NOME=([repo]="Repositórios" [aur]="AUR" [flatpak]="Flatpak" [appimage]="AppImage")
    local b
    for b in repo aur flatpak appimage; do
        ((ATIVO[$b])) || continue
        titulo "${NOME[$b]}"
        if [[ -s $STATEDIR/updates_$b ]]; then
            sed 's/^/   /' "$STATEDIR/updates_$b"
        else
            echo "   nenhuma atualização"
        fi
    done
    ((USAR_APPMAN)) && { titulo "AppMan"; echo "   verificado durante a atualização (appman -u)"; }
    echo
}

atualizar_estado() {
    verificar
    icone_atual > "$STATEDIR/tray_icon"
}

# ---------- modo check (timer) ----------
if [[ $MODO == check ]]; then
    atualizar_estado
    notificar_se_mudou
    exit 0
fi

# ---------- modo list / update ----------
info "Verificando atualizações..."
atualizar_estado
cp -f "$STATEDIR/updates_all" "$STATEDIR/notified"
mostrar_lista

TOTAL=$(grep -c . "$STATEDIR/updates_all")
if ((TOTAL == 0)) && ((USAR_APPMAN == 0)); then
    info "Sistema atualizado. Nada a fazer."
    fim 0
fi
((TOTAL > 0)) && info "Atualizações disponíveis: $TOTAL"
[[ $MODO == list ]] && fim 0

if ((! SEM_CONFIRMAR)); then
    read -rp "$(printf '%s::%s Prosseguir com a atualização? [S/n] ' "$C$B" "$N")" resp
    case "${resp,,}" in
        ""|s|sim|y|yes) ;;
        *) info "Cancelado."; fim 0 ;;
    esac
fi

# ---------- atualizar ----------
upgrade_args=(-n upgrade all)          # -n: já confirmamos acima
((ATIVO[repo]))     || upgrade_args+=(--no-repo)
((ATIVO[aur]))      || upgrade_args+=(--no-aur)
((ATIVO[flatpak]))  || upgrade_args+=(--no-flatpak)
((ATIVO[appimage])) || upgrade_args+=(--no-appimage)
((SEM_DEVEL))       && upgrade_args+=(--no-devel)

STATUS=0
if ((TOTAL > 0)); then
    titulo "Atualizando com o Shelly"
    shelly "${upgrade_args[@]}" || { STATUS=1; erro "O Shelly informou falha em pelo menos um backend."; }
fi
if ((USAR_APPMAN)); then
    titulo "Atualizando AppImages do AppMan"
    appman -u || { STATUS=1; erro "Falha no appman -u."; }
fi

# ---------- pós-atualização (como o arch-update) ----------
if ((ATIVO[repo] || ATIVO[aur])); then
    if command -v pacdiff >/dev/null 2>&1; then
        pac="$(pacdiff -o 2>/dev/null)"
        if [[ -n $pac ]]; then
            titulo "Arquivos .pacnew/.pacsave pendentes"
            printf '%s\n' "$pac" | sed 's/^/   /'
            echo "   Revise com: sudo pacdiff -s"
        fi
    fi
    orf="$(pacman -Qtdq 2>/dev/null)"
    if [[ -n $orf ]]; then
        titulo "Pacotes órfãos"
        printf '%s\n' "$orf" | sed 's/^/   /'
        echo "   Remova com: sudo pacman -Rns \$(pacman -Qtdq)"
    fi
    if [[ ! -d /usr/lib/modules/$(uname -r) ]]; then
        titulo "Reinicialização recomendada"
        echo "   O kernel em execução ($(uname -r)) foi substituído."
    fi
fi

# Verifica de novo para a bandeja voltar ao ícone "em dia"
echo
info "Atualizando o estado da bandeja..."
atualizar_estado
cp -f "$STATEDIR/updates_all" "$STATEDIR/notified"

echo
if ((STATUS == 0)); then info "Atualização concluída."; else warn "Concluída com erros. Veja as mensagens acima."; fi
fim "$STATUS"
