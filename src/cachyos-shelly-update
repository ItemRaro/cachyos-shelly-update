#!/usr/bin/env -S python3 -I -S
# cachyos-shelly-update launcher. Installed in /opt/cachyos-shelly-update/bin
# (linked from /usr/local/bin) with the code in ../lib/shellyupdate; when
# run from the repository, the code sits next to it in src/shellyupdate.
# -I -S: ignore PYTHON* variables, the user's site-packages and site itself.
# Only the standard library is needed, and it starts faster.
import os
import sys

selfPath = os.path.realpath(__file__)
binDir = os.path.dirname(selfPath)
prefix = os.path.dirname(binDir)
libDir = os.environ.get("CACHYOS_SHELLY_UPDATE_LIBDIR") or (
    binDir if os.path.isdir(os.path.join(binDir, "shellyupdate")) else os.path.join(prefix, "lib"))
sys.path.insert(0, libDir)

from shellyupdate import cli  # noqa: E402

sys.exit(cli.main(selfPath, prefix, libDir, sys.argv[1:]))
